{
  "name": "summ-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Keep Summ matching a set of Summ CSV files: pull, plan, apply through Summ's MCP server",
  "type": "module",
  "bin": {
    "summ-sync": "bin/summ-sync.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-lines=95 --test-coverage-branches=92 --test-coverage-functions=94 test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=24"
  }
}
